diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..610ade2
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,57 @@
+#!/bin/bash
+set -uo pipefail
+
+OUTPUT_PATH=""
+MODE=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path)
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#*=}"
+      shift
+      ;;
+    *)
+      MODE="$1"
+      shift
+      ;;
+  esac
+done
+
+NEW_TESTS=(test/jit-parity-529962.test.js)
+
+# Resolved against the caller's directory, before changing to the repository
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  OUTPUT_PATH="$(cd "$(dirname "$OUTPUT_PATH")" && pwd)/$(basename "$OUTPUT_PATH")"
+fi
+
+cd "$(dirname "$0")"
+
+run_borp () {
+  local reporters=(--reporter spec)
+  if [ -n "$OUTPUT_PATH" ]; then
+    # The JUnit reporter also records test files that fail to load as failures
+    reporters+=(--reporter "junit:$OUTPUT_PATH")
+  fi
+  node_modules/.bin/borp --timeout 300000 "${reporters[@]}" "$@"
+}
+
+case "$MODE" in
+  base)
+    ignore=()
+    for test_file in "${NEW_TESTS[@]}"; do
+      ignore+=(--ignore "$test_file")
+    done
+    run_borp "${ignore[@]}" 'test/**/*.test.js'
+    ;;
+  new)
+    run_borp "${NEW_TESTS[@]}"
+    ;;
+  *)
+    echo "Usage: ./test.sh --output_path <path> [base|new]" >&2
+    exit 1
+    ;;
+esac
diff --git a/test/jit-parity-529962.test.js b/test/jit-parity-529962.test.js
new file mode 100644
index 0000000..514b28c
--- /dev/null
+++ b/test/jit-parity-529962.test.js
@@ -0,0 +1,211 @@
+'use strict'
+
+const { test } = require('node:test')
+const Fastify = require('fastify')
+const { buildSchema } = require('graphql')
+const GQL = require('..')
+
+const schema = `
+  type Dog { name: String!, owner: String }
+  type Query {
+    add(x: Int!, y: Int = 1): Int
+    hello(name: String): String
+    dogs: [Dog]
+    boom: Int
+  }
+`
+
+// A different schema for replaceSchema: `dogs` and `boom` are gone and `version` is new.
+const replacementSchema = `
+  type Query {
+    add(x: Int!, y: Int = 1): Int
+    hello(name: String): String
+    version: Int
+  }
+`
+
+function makeResolvers () {
+  return {
+    Query: {
+      add: (_, { x, y }) => x + y,
+      hello: (_, { name }) => `hello ${name}`,
+      dogs: () => [{ name: 'max' }, { name: 'rex' }],
+      boom: () => { throw new Error('kaboom') }
+    },
+    Dog: { owner: (dog) => `owner of ${dog.name}` }
+  }
+}
+
+// The reference app caches nothing and compiles nothing, so every request is parsed, validated and executed
+// against the schema and resolvers as they are at that moment.
+const modes = {
+  reference: { cache: false },
+  'default cache': {},
+  'jit: 1': { jit: 1 },
+  'jit: 2': { jit: 2 },
+  'adaptive jit': { jit: { minCount: 1, eluThreshold: 1 } },
+  'adaptive jit, minCount 2': { jit: { minCount: 2, eluThreshold: 1, maxCompilePerTick: 4, maxQueueSize: 10 } }
+}
+
+// A change queued for an app runs inside the next request's preExecution hook, after that request has read the
+// caches but before it executes, like a slow auth check that overlaps a runtime update.
+const changesDuringRequest = new WeakMap()
+
+async function buildApps (t) {
+  const apps = {}
+  for (const [name, opts] of Object.entries(modes)) {
+    const app = Fastify()
+    t.after(() => app.close())
+    await app.register(GQL, { schema, resolvers: makeResolvers(), ...opts })
+    app.graphql.addHook('preExecution', async () => {
+      const change = changesDuringRequest.get(app)
+      if (change) {
+        changesDuringRequest.delete(app)
+        await change(app)
+      }
+    })
+    await app.ready()
+    apps[name] = app
+  }
+  return apps
+}
+
+// The adaptive compiler first tries right after a request, while the event loop is busy, so it backs off and retries
+// from a 50ms timer. Node runs timers in order of when they are due, so this one always fires after that retry and
+// the next request can use what it compiled.
+const settleAdaptive = () => new Promise((resolve) => setTimeout(resolve, 60))
+
+// Runs the same steps against every app and returns, per app, the status code and parsed body of each request.
+async function play (apps, steps) {
+  const results = {}
+  for (const [name, app] of Object.entries(apps)) {
+    const adaptive = typeof modes[name].jit === 'object'
+    const out = []
+    for (const step of steps) {
+      if (typeof step === 'function') {
+        await step(app)
+        continue
+      }
+      const { query, variables, during } = step
+      if (during) {
+        changesDuringRequest.set(app, during)
+      }
+      const res = await app.inject({ method: 'POST', url: '/graphql', body: { query, variables } })
+      out.push({ status: res.statusCode, body: res.json() })
+      if (adaptive) {
+        await settleAdaptive()
+      }
+    }
+    results[name] = out
+  }
+  return results
+}
+
+function assertSameAsReference (t, results) {
+  for (const [name, out] of Object.entries(results)) {
+    t.assert.deepStrictEqual([name, out], [name, results.reference])
+  }
+}
+
+const repeat = (step, times) => Array.from({ length: times }, () => step)
+
+const queryFieldNames = '{ __type(name: "Query") { fields { name } } }'
+const fieldNames = (result) => result.body.data.__type.fields.map((field) => field.name)
+
+test('resolvers replaced with defineResolvers apply to queries that were already compiled', async (t) => {
+  const apps = await buildApps(t)
+  const results = await play(apps, [
+    ...repeat({ query: '{ add(x: 1) dogs { name owner } }' }, 3),
+    ...repeat({ query: 'query($x: Int!) { add(x: $x) }', variables: { x: 5 } }, 3),
+    (app) => app.graphql.defineResolvers({ Query: { add: (_, { x, y }) => x * 10 + y }, Dog: { owner: () => 'nobody' } }),
+    ...repeat({ query: '{ add(x: 1) dogs { name owner } }' }, 3),
+    ...repeat({ query: 'query($x: Int!) { add(x: $x) }', variables: { x: 5 } }, 3),
+    (app) => app.graphql.defineResolvers({ Query: { boom: () => 7 } }),
+    ...repeat({ query: '{ boom hello(name: "z") }' }, 3)
+  ])
+  assertSameAsReference(t, results)
+  t.assert.deepStrictEqual(results.reference[8], {
+    status: 200,
+    body: { data: { add: 11, dogs: [{ name: 'max', owner: 'nobody' }, { name: 'rex', owner: 'nobody' }] } }
+  })
+})
+
+test('a schema extension applies to queries that failed or were compiled before it', async (t) => {
+  const apps = await buildApps(t)
+  const results = await play(apps, [
+    ...repeat({ query: '{ extra add(x: 3) }' }, 3),
+    ...repeat({ query: '{ add(x: 3) dogs { name } }' }, 3),
+    (app) => {
+      app.graphql.extendSchema('extend type Query { extra: Int } extend type Dog { age: Int }')
+      app.graphql.defineResolvers({ Query: { extra: () => 42, add: () => -1 }, Dog: { age: () => 3 } })
+    },
+    ...repeat({ query: '{ extra add(x: 3) }' }, 3),
+    ...repeat({ query: '{ add(x: 3) dogs { name } }' }, 3),
+    ...repeat({ query: '{ dogs { name age } }' }, 2)
+  ])
+  assertSameAsReference(t, results)
+  t.assert.strictEqual(results.reference[0].status, 400)
+  t.assert.deepStrictEqual(results.reference[6], { status: 200, body: { data: { extra: 42, add: -1 } } })
+})
+
+test('a different schema installed with replaceSchema applies to queries used before it', async (t) => {
+  const apps = await buildApps(t)
+  const steps = [
+    ...repeat({ query: '{ version hello(name: "q") }' }, 3),
+    ...repeat({ query: '{ dogs { name } add(x: 1) }' }, 3),
+    ...repeat({ query: '{ hello(name: "q") add(x: 1) }' }, 3),
+    (app) => {
+      app.graphql.replaceSchema(buildSchema(replacementSchema))
+      app.graphql.defineResolvers({ Query: { version: () => 2, hello: () => 'replaced', add: (_, { x }) => x * 100 } })
+    },
+    ...repeat({ query: '{ version hello(name: "q") }' }, 3),
+    ...repeat({ query: '{ dogs { name } add(x: 1) }' }, 3),
+    ...repeat({ query: '{ hello(name: "q") add(x: 1) }' }, 3),
+    (app) => app.graphql.defineResolvers({ Query: { hello: () => 'defined later' } }),
+    ...repeat({ query: '{ hello(name: "q") add(x: 1) }' }, 2)
+  ]
+  const results = await play(apps, steps)
+  assertSameAsReference(t, results)
+  t.assert.strictEqual(results.reference[0].status, 400)
+  t.assert.deepStrictEqual(results.reference[9], { status: 200, body: { data: { version: 2, hello: 'replaced' } } })
+  t.assert.strictEqual(results.reference[12].status, 400)
+  t.assert.deepStrictEqual(results.reference[18], { status: 200, body: { data: { hello: 'defined later', add: 100 } } })
+})
+
+test('a resolver change made while a request waits in its hooks applies to that request', async (t) => {
+  const apps = await buildApps(t)
+  const query = '{ add(x: 1) dogs { name owner } }'
+  const results = await play(apps, [
+    ...repeat({ query }, 3),
+    { query, during: (app) => app.graphql.defineResolvers({ Query: { add: () => 100 }, Dog: { owner: () => 'nobody' } }) },
+    ...repeat({ query }, 2)
+  ])
+  assertSameAsReference(t, results)
+  t.assert.deepStrictEqual(results.reference[3], {
+    status: 200,
+    body: { data: { add: 100, dogs: [{ name: 'max', owner: 'nobody' }, { name: 'rex', owner: 'nobody' }] } }
+  })
+})
+
+test('a schema change made while a request waits in its hooks applies to that request', async (t) => {
+  const apps = await buildApps(t)
+  const query = '{ hello(name: "q") add(x: 1) }'
+  const results = await play(apps, [
+    ...repeat({ query: queryFieldNames }, 3),
+    { query: queryFieldNames, during: (app) => app.graphql.extendSchema('extend type Query { extra: Int }') },
+    ...repeat({ query }, 3),
+    {
+      query,
+      during: (app) => {
+        app.graphql.replaceSchema(buildSchema(replacementSchema))
+        app.graphql.defineResolvers({ Query: { hello: () => 'replaced' } })
+      }
+    },
+    ...repeat({ query }, 2)
+  ])
+  assertSameAsReference(t, results)
+  t.assert.deepStrictEqual(fieldNames(results.reference[0]), ['add', 'hello', 'dogs', 'boom'])
+  t.assert.deepStrictEqual(fieldNames(results.reference[3]), ['add', 'hello', 'dogs', 'boom', 'extra'])
+  // the replacement schema has no resolver for `add`, so the default resolver returns null
+  t.assert.deepStrictEqual(results.reference[7], { status: 200, body: { data: { hello: 'replaced', add: null } } })
+})
